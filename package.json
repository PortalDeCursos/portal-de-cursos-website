{
  "name": "portal-de-cursos",
  "version": "0.1.0",
  "private": true,
  "description": "Protótipo acadêmico navegável preparado para evolução incremental",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/catalog.test.mjs",
    "build": "tsc -b && vite build --configLoader native",
    "check:views": "node tests/render-catalog-loading.mjs",
    "preview": "vite preview",
    "check": "npm run lint && npm run test && npm run build && npm run check:views"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
