# Destino do proxy Vite em desenvolvimento (sem barra final).
USUARIOS_API_URL=http://127.0.0.1:8080
# Destino do proxy Vite para a API de cursos (sem barra final).
CURSOS_API_URL=http://127.0.0.1:8081
# Caminhos versionados usados pelo frontend; servidos pelo proxy do Vite em desenvolvimento.
VITE_API_CURSOS_URL=/api/v1/cursos
VITE_API_DISCIPLINAS_URL=/api/v1/disciplinas
# Opcional: URL completa de POST /auth/login para usar API HTTPS diretamente.
# Nesse caso, o backend deve autorizar CORS para a origem do portal.
VITE_API_AUTENTICACAO=
